{
  "name": "opendata-vda",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:gateway": "pnpm --filter gateway-service dev",
    "dev:geography": "pnpm --filter geography-service dev",
    "dev:weather": "pnpm --filter weather-service dev",
    "dev:vigilance": "npm --prefix services/weather-vigilance run dev",
    "dev:fire-detection": "npm --prefix services/fire-detection run dev",
    "dev:worker": "pnpm --filter worker dev",
    "dev:meteo-v2": "pnpm --filter meteo-web dev",
    "dev:meteo-v2:mock": "pnpm --filter meteo-web dev:mock",
    "worker:once": "pnpm --filter worker run once",
    "build:web": "pnpm --filter web build",
    "build:meteo-v2": "pnpm --filter meteo-web build",
    "test:gateway": "pnpm --filter gateway-service test",
    "test:geography": "pnpm --filter geography-service test",
    "test:weather": "pnpm --filter weather-service test",
    "test:vigilance": "npm --prefix services/weather-vigilance test",
    "test:fire-detection": "npm --prefix services/fire-detection test",
    "check:gateway": "pnpm --filter gateway-service typecheck && pnpm test:gateway",
    "check:weather": "pnpm --filter weather-service typecheck && pnpm test:weather",
    "check:vigilance": "npm --prefix services/weather-vigilance run typecheck && npm run test:vigilance",
    "check:fire-detection": "npm --prefix services/fire-detection run typecheck && npm run test:fire-detection",
    "test:meteo-v2": "pnpm --filter meteo-web test",
    "verify:meteo-national": "node scripts/verify-meteo-national.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:incendies": "pnpm --filter api test && pnpm --filter worker test",
    "check:incendies": "pnpm test:incendies && pnpm --filter api exec tsc --noEmit && pnpm --filter worker exec tsc --noEmit && pnpm build:web"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@11.10.0"
}
