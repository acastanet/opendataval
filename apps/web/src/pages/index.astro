---
import Layout from "../layouts/Layout.astro";
import LauncherGrid from "../islands/LauncherGrid.svelte";
import { SECTIONS } from "@opendata-vda/shared/sections";

// Les descriptifs reprennent la description déclarée par chaque page cible
// (balise `description` du Layout) ou le champ `role` du catalogue de services
// du gateway, afin de décrire le contenu réel et non le titre reformulé.
const applicationsGrandPublic = [
  { id: "incendies", label: "Fe", name: "Incendies — risque & consignes", description: "Recommandations officielles incendie pour les massifs gardois autour de l'Aigoual.", href: "/incendies/", icon: "fire", color: "#D96832" },
  { id: "incendies-temps-reel", label: "Fe", name: "Incendies — temps réel & méthodologie", description: "Détections thermiques NASA FIRMS et périmètres de veille autour de l'Aigoual.", href: "/incendies/temps-reel/", icon: "fire-live", color: "#D96832" },
  { id: "vigilance-feu", label: "Vi", name: "Vigilance incendie", description: "Couleur d'alerte du massif et carte des anomalies thermiques du département du Gard.", href: "/vigilance-feu/", icon: "vigilance", color: "#D96832" },
  { id: "eau", label: "Ea", name: "Eau — rivière, crues & nappe", description: "Parcours didactique en carte 3D : le voyage de l'eau, de l'Aigoual à la Méditerranée.", href: "/eau/", icon: "water", color: "#168AAD" },
  { id: "eau-tableau-de-bord", label: "Ea", name: "Eau — tableau de bord", description: "Quantité, crues, étiages, nappes, qualité physico-chimique et baignade.", href: "/eau/tableau-de-bord/", icon: "water-dashboard", color: "#168AAD" },
  { id: "carte", label: "Ca", name: "Carte du territoire", description: "Carte interactive des données ouvertes : géologie, sous-sol, eau, nature, services publics.", href: "/carte/", icon: "map", color: "#087F5B" },
  { id: "relief", label: "Re", name: "Relief 3D", description: "Teinte hypsométrique et ombrage calculés depuis le MNT Copernicus GLO-30 et le LiDAR HD IGN.", href: "/relief/", icon: "relief", color: "#087F5B" },
  // iconColor : le jaune et le vert clair de la charte tombent sous 3:1 sur le
  // recto blanc ; ces teintes assombries gardent la famille et restent lisibles.
  { id: "valleraugue-3d", label: "3D", name: "Jumeau numérique 3D — POC Valleraugue", description: "Maquette LiDAR en quatre vues à caméra commune : sol nu, végétation, nuage source, superposé.", href: "/valleraugue-3d/", icon: "cube", color: "#F4C430", textColor: "#18302A", iconColor: "#A6780A" },
  { id: "meteo", label: "Mé", name: "Météo", description: "Prévision localisée à une adresse, un lieu-dit ou une position GPS dans Val-d'Aigoual.", href: "/meteo/", icon: "meteo", color: "#168AAD" },
  { id: "meteo-essentiel", label: "Mé", name: "Météo essentielle", description: "Position GPS, situation actuelle, risque à venir et prévisions utiles.", href: "/meteo/essentiel/", icon: "meteo-essentiel", color: "#168AAD" },
  { id: "meteo-bilan-thermique", label: "Mé", name: "Météo — bilan thermique", description: "Stress thermique UTCI et nuits tropicales du dernier mois complet, via Copernicus ERA5-HEAT.", href: "/meteo/bilan-thermique/", icon: "thermique", color: "#168AAD" },
  { id: "meteo-comparaison", label: "Mé", name: "Météo — comparaison", description: "Prévisions de J−1 confrontées à leur version actualisée à J, sans les confondre avec des observations.", href: "/meteo/comparaison/", icon: "comparaison", color: "#168AAD" },
  { id: "meteo-informations", label: "Mé", name: "Météo — informations", description: "Informations d'usage, limites et sources de la météo essentielle.", href: "/meteo/informations/", icon: "infos", color: "#168AAD" },
  { id: "meteo-v2", label: "M2", name: "Météo v2", description: "Interface v2 adossée au gateway : température et provenance exacte de la mesure affichée.", href: "/meteo-v2/", icon: "meteo-v2", color: "#55B938", iconColor: "#43912B" },
  { id: "old", label: "OL", name: "OLD — Obligations légales de débroussaillement", description: "Zonage OLD et périmètre indicatif de débroussaillement depuis le bâtiment, le cadastre et le PLU.", href: "/old/", icon: "old", color: "#D96832" },
  { id: "itineraire-poids-lourd", label: "PL", name: "Itinéraire poids lourd", description: "Itinéraire camion selon le gabarit connu dans OpenStreetMap, portions à vérifier signalées.", href: "/itineraire-poids-lourd/", icon: "truck", color: "#D96832" },
  { id: "valfeu", label: "VF", name: "Application terrain (Valfeu)", description: "Application mobile de terrain : position, carte et suspicions satellitaires de feu à proximité.", href: "/valfeu", icon: "terrain", color: "#55B938", iconColor: "#43912B" },
];

const themes = SECTIONS.map((section) => ({
  id: `theme-${section.slug}`,
  label: section.titre.slice(0, 2).toUpperCase(),
  name: section.titre,
  description: section.description,
  href: `/${section.slug}/`,
  icon: `theme-${section.slug}`,
  color: section.couleur,
}));

const technique = [
  { id: "api-v2", label: "V2", name: "Accueil des services v2", description: "Catalogue des microservices v2 : rôle, routes exposées et paramètres de chaque service.", href: "/api/v2", icon: "server" },
  { id: "api-v2-status", label: "St", name: "État des services v2 (live)", description: "État de santé en direct de chaque microservice v2 et de ses dépendances.", href: "/api/v2/status", icon: "gauge" },
  { id: "demo-gateway", label: "Ga", name: "Démo — Gateway", description: "Façade HTTP unique des API v2 : valide les paramètres, propage x-request-id, normalise les erreurs.", href: "/api/v2/demo/gateway", icon: "gateway" },
  { id: "demo-map", label: "Ma", name: "Démo — Map", description: "Styles, tuiles, relief et légendes cartographiques, servis directement par Caddy.", href: "/api/v2/demo/map", icon: "map" },
  { id: "demo-geography", label: "Ge", name: "Démo — Geography", description: "Résout des coordonnées lat/lon vers la commune et le département, avec altitude.", href: "/api/v2/demo/geography", icon: "globe" },
  { id: "demo-weather", label: "We", name: "Démo — Weather", description: "Température ponctuelle pour une position, modèle MétéoFrance et contexte territorial.", href: "/api/v2/demo/weather", icon: "meteo-essentiel" },
  { id: "demo-vigilance", label: "Vi", name: "Démo — Weather Vigilance", description: "Vigilance météorologique départementale officielle MétéoFrance, avec bulletins optionnels.", href: "/api/v2/demo/vigilance", icon: "vigilance" },
  { id: "demo-fire", label: "Fi", name: "Démo — Fire Detection", description: "Suspicions satellitaires de feu à proximité (FIRMS + EUMETSAT), rayon et historique explicites.", href: "/api/v2/demo/fire", icon: "fire" },
  { id: "demo-associations", label: "As", name: "Démo — Associations", description: "Liste consolidée, recherchable et cartographiable des associations d'une commune française.", href: "/api/v2/demo/associations", icon: "associations" },
  { id: "demo-old", label: "OL", name: "Démo — OLD", description: "Applicabilité des obligations de débroussaillement et périmètre indicatif calculé.", href: "/api/v2/demo/old", icon: "old" },
  { id: "demo-itineraire-poids-lourd", label: "PL", name: "Démo — Itinéraire poids lourd", description: "Itinéraire camion compatible avec les restrictions OSM, portions non vérifiées affichées.", href: "/api/v2/demo/itineraire-poids-lourd", icon: "truck" },
  { id: "demo-legacy", label: "Lg", name: "Démo — Legacy", description: "Pont en lecture seule vers le monolithe historique /api/*, en GET et HEAD uniquement.", href: "/api/v2/demo/legacy", icon: "legacy" },
].map((service) => ({ ...service, color: "#4f5d66" }));

const cells = [
  ...applicationsGrandPublic.map((cell) => ({ ...cell, category: "app" as const })),
  ...themes.map((cell) => ({ ...cell, category: "theme" as const })),
  ...technique.map((cell) => ({ ...cell, category: "tech" as const })),
];
---

<Layout
  title="OpenDataVal — Portail des services"
  description="Portail unique pour accéder à toutes les applications, thèmes de données et services techniques d'OpenDataVal, le jumeau numérique ouvert de Val-d'Aigoual."
>
  <main class="launcher-page">
    <header class="launcher-hero">
      <p class="sur-titre">Val-d'Aigoual · portail des services</p>
      <h1>Un seul accès pour tout le territoire numérique.</h1>
      <p class="introduction">
        Survolez une tuile : elle pivote et révèle ce qu'elle contient ainsi que ses actions. Cliquez pour ouvrir l'application. Chaque couleur distingue les applications de terrain, les thèmes de données et les services techniques.
      </p>
      <ul class="legende" aria-hidden="true">
        <li><span class="pastille" style="--c:#168AAD"></span>Applications</li>
        <li><span class="pastille" style="--c:#3e6e82"></span>Thèmes &amp; données</li>
        <li><span class="pastille" style="--c:#4f5d66"></span>Services techniques</li>
      </ul>
    </header>
    <LauncherGrid client:load cells={cells} />
  </main>
</Layout>

<style>
  .launcher-page {
    width: min(1280px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) 0 clamp(3rem, 8vw, 6rem);
  }

  .launcher-hero {
    max-width: 62ch;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .sur-titre {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.9rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .introduction {
    margin: 1.1rem 0 0;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .legende {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--muted);
  }

  .legende li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .pastille {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 2px;
    background: var(--c);
    display: inline-block;
  }
</style>
