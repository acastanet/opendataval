---
import Layout from "../layouts/Layout.astro";
import HeroVisual from "../components/HeroVisual.astro";
import ImagePlaceholder from "../components/ImagePlaceholder.astro";
import CarteUsage from "../components/CarteUsage.astro";
import { findApplication } from "../lib/landing";
import { ANCRES_ACCUEIL } from "../lib/navigation";

// Les huit usages du portail, rangés en deux entrées majeures puis six entrées
// courantes. Cinq familles de données seulement : une couleur par famille, pas
// une couleur par carte, sinon le classement ne se lit plus.
const usages = [
  {
    numero: "01",
    sphere: "anthroposphere",
    sphereNom: "Anthroposphère",
    rang: "majeure",
    titre: "Carte du territoire",
    description: "Rassemble sur une même interface les données relatives à la géologie, au sous-sol, à l’eau, aux milieux naturels et aux services publics.",
    liens: [findApplication("carte")],
  },
  {
    numero: "02",
    sphere: "lithosphere",
    sphereNom: "Lithosphère",
    rang: "majeure",
    titre: "Relief 3D",
    description: "Permet d’explorer le terrain, les bâtiments et la végétation à partir des données LiDAR et des modèles numériques de terrain.",
    liens: [findApplication("relief"), findApplication("valleraugue-3d")],
  },
  {
    numero: "03",
    sphere: "atmosphere",
    sphereNom: "Atmosphère",
    rang: "courante",
    titre: "Météo et climat",
    description: "Une information localisée sur la situation météorologique, les prévisions et les évolutions climatiques du lieu.",
    liens: [findApplication("meteo-essentiel"), findApplication("meteo-bilan-thermique"), findApplication("climat")],
  },
  {
    numero: "04",
    sphere: "hydrosphere",
    sphereNom: "Hydrosphère",
    rang: "courante",
    titre: "Tableau de bord de l’eau",
    description: "Suit les cours d’eau, les crues, les étiages, les nappes souterraines ainsi que la qualité de l’eau et des sites de baignade.",
    liens: [findApplication("eau-tableau-de-bord")],
  },
  {
    numero: "05",
    sphere: "risques",
    sphereNom: "Risques",
    rang: "courante",
    titre: "Incendies",
    description: "Met en relation les niveaux officiels de vigilance, les recommandations publiques et les détections thermiques satellitaires récentes.",
    liens: [findApplication("incendies"), findApplication("vigilance-feu"), findApplication("incendies-temps-reel")],
  },
  {
    numero: "06",
    sphere: "risques",
    sphereNom: "Risques",
    rang: "courante",
    titre: "LAV.feu",
    description: "Conçue pour un usage mobile sur le terrain, localise l’utilisateur et recherche les suspicions satellitaires de feu observées à proximité.",
    liens: [findApplication("valfeu")],
  },
  {
    numero: "07",
    sphere: "risques",
    sphereNom: "Risques",
    rang: "courante",
    titre: "Obligations de débroussaillement",
    description: "Aide à préparer le périmètre indicatif à débroussailler en croisant bâtiment, cadastre, zonage réglementaire et données cartographiques.",
    liens: [findApplication("old")],
  },
  {
    numero: "08",
    sphere: "anthroposphere",
    sphereNom: "Anthroposphère",
    rang: "courante",
    titre: "Itinéraire poids lourd",
    description: "Propose un parcours adapté au gabarit connu du véhicule et signale les portions que les données ouvertes ne permettent pas de vérifier complètement.",
    liens: [findApplication("itineraire-poids-lourd")],
  },
  {
    numero: "09",
    sphere: "lithosphere",
    sphereNom: "Lithosphère",
    rang: "courante",
    titre: "Lavgeol",
    description: "Explore la carte géologique du territoire, croise fonds IGN et relief 3D, et retrouve les ouvrages du sous-sol répertoriés par le BRGM (BSS) à proximité.",
    liens: [findApplication("lavgeol")],
  },
] as const;

const majeures = usages.filter((usage) => usage.rang === "majeure");
const courantes = usages.filter((usage) => usage.rang === "courante");
const [projet, demarche, applications] = ANCRES_ACCUEIL;
---

<Layout
  title="LAV — Localiser, Agréger, Valoriser"
  description="Un système d’intégration des données publiques au service des territoires et des usages."
>
  <header class="entete">
    <div class="conteneur hero">
      <div class="hero__texte">
        {/* La marque est déjà portée par la barre permanente : la répéter ici
            n'ajouterait rien et volerait de la place au titre. */}
        <h1>Localiser, agréger, valoriser.</h1>
        <p class="hero__accroche">Un système d’intégration des données publiques au service des territoires et des usages.</p>
        <p class="introduction">LAV transforme des données publiques dispersées en informations utiles, organisées autour d’un lieu.</p>
        <a class="hero__appel" href={`#${applications.id}`}>Voir les applications <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero__medias">
        <HeroVisual />
      </div>
    </div>
    <span class="sentinelle" data-sentinelle-entete aria-hidden="true"></span>
  </header>

  <main>
    <section id={projet.id} class="section manifeste" aria-labelledby="projet-titre">
      <div class="conteneur">
        <p class="indice-section">{projet.numero} · {projet.titre}</p>
        <div class="manifeste__grille">
          <h2 id="projet-titre">Un jumeau numérique documenté et évolutif.</h2>
          <div class="prose">
            <p>À partir d’un point sur la carte, LAV rassemble les données disponibles pour décrire son environnement : relief, bâtiments, végétation, eau, sous-sol, météo, climat, activités humaines, infrastructures et risques.</p>
            <p>Issues de multiples sources publiques, ces données sont localisées, croisées et replacées dans leur contexte. Elles proposent une lecture cohérente du lieu, de son voisinage et de son territoire.</p>
            <p>LAV fournit ainsi un socle de données commun, à partir duquel peuvent être développés des services répondant à des besoins concrets, locaux et citoyens.</p>
          </div>
        </div>
      </div>
    </section>

    <section id={demarche.id} class="section section--fond" aria-labelledby="demarche-titre">
      <div class="conteneur">
        <div class="section__entete">
          <div>
            <p class="indice-section">{demarche.numero} · {demarche.titre}</p>
            <h2 id="demarche-titre">Du point sur la carte à l’information utile.</h2>
          </div>
          <p>Une même infrastructure de localisation, de collecte, de cartographie et de documentation des données.</p>
        </div>

        <div class="demarche__corps">
          <ol class="etapes">
            <li><span>01</span><div><h3>Localiser</h3><p>Partir d’un lieu précis et retrouver son contexte géographique.</p></div></li>
            <li><span>02</span><div><h3>Agréger</h3><p>Rassembler des sources publiques différentes dans un socle commun et documenté.</p></div></li>
            <li><span>03</span><div><h3>Valoriser</h3><p>Développer des services répondant à des besoins concrets, locaux et citoyens.</p></div></li>
          </ol>
          <div class="demarche__appui">
            <ImagePlaceholder />
            <p class="demarche__note">Les applications s’appuient toutes sur cette infrastructure. Elles peuvent ainsi être enrichies ou complétées sans reconnecter séparément chaque source publique.</p>
          </div>
        </div>
      </div>
    </section>

    <section id={applications.id} class="section" aria-labelledby="applications-titre">
      <div class="conteneur">
        <div class="section__entete">
          <div>
            <p class="indice-section">{applications.numero} · {applications.titre}</p>
            <h2 id="applications-titre">Une infrastructure commune, des usages concrets.</h2>
          </div>
          <p>Les applications déjà réalisées illustrent cette diversité d’usages.</p>
        </div>

        <div class="applications applications--majeures">
          {majeures.map((usage) => <CarteUsage {...usage} />)}
        </div>

        <div class="applications applications--courantes">
          {courantes.map((usage) => <CarteUsage {...usage} />)}
        </div>
      </div>
    </section>
  </main>

  <section class="sortie conteneur" slot="final" aria-labelledby="finalites-titre">
    <p class="indice-section">04 · Les finalités</p>
    <p id="finalites-titre" class="sortie__phrase">Comprendre un lieu. Suivre une situation. Préparer une intervention. Éclairer une décision.</p>
    <div class="sortie__suite">
      <p>Autour de l’infrastructure commune, chaque application répond à une question concrète, locale et citoyenne.</p>
      <div class="sortie__appels">
        <a class="bouton" href="/carte/">Ouvrir la carte du territoire</a>
        <a class="bouton bouton--discret" href={`#${applications.id}`}>Revoir les applications</a>
        <a class="bouton bouton--discret" href="/api/v2">Services &amp; API</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  :global(body) {
    background: var(--surface-fond);
    color: var(--texte-principal);
    font-family: var(--font-body);
    font-size: var(--txt-l);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  :global(html) { scroll-behavior: smooth; }

  /* ---- Hero ----
     Aucun ornement : ni dégradé radial ni cercle. Le seul geste graphique de la
     page est réservé au bloc sombre final, où il ne concurrence rien. */
  /* Dégradé vertical : la barre permanente, plate et de la même couleur en haut
     de page, s'y raccorde sans coupure sur toute la largeur. */
  .entete { position: relative; border-bottom: 1px solid var(--bordure); background: linear-gradient(var(--surface-plate) 0 42%, var(--surface-fond) 100%); }
  .hero { display: grid; min-height: calc(100svh - 3.5rem); gap: var(--esp-xl); align-items: center; padding-block: clamp(var(--esp-xl), 7vw, 5rem); }
  .hero__texte { display: grid; justify-items: start; align-content: center; }
  .hero__accroche { max-width: 46ch; margin: var(--esp-l) 0 0; color: var(--texte-principal); font-family: var(--font-display); font-size: clamp(1.15rem, 2vw, 1.45rem); line-height: 1.2; text-wrap: balance; }
  .introduction { max-width: 48ch; margin: var(--esp-m) 0 0; color: var(--texte-secondaire); font-size: clamp(1rem, 1.7vw, 1.2rem); text-wrap: pretty; }
  .hero__appel { display: inline-flex; min-height: var(--cible); align-items: center; gap: var(--esp-s); margin-top: var(--esp-xl); border-bottom: 1px solid var(--couleur-action); color: var(--couleur-action); font-size: var(--txt-xs); font-weight: var(--poids-fort); text-decoration: none; }
  .hero__medias { display: grid; min-width: 0; }
  /* Repère de défilement lu par la barre permanente (aucun rendu propre). */
  .sentinelle { position: absolute; bottom: 0; display: block; height: 1px; width: 1px; }

  /* ---- Titres et repères communs ---- */
  .indice-section { margin: 0 0 var(--esp-s); color: var(--couleur-action); font-family: var(--font-mono); font-size: var(--txt-micro); font-weight: var(--poids-fort); letter-spacing: var(--ls-label); text-transform: uppercase; }
  h1, h2 { font-family: var(--font-display); font-weight: var(--poids-normal); letter-spacing: var(--ls-titre); text-wrap: balance; }
  h1 { max-width: 10ch; margin: 0; font-size: clamp(2.65rem, 6.2vw, 5.4rem); line-height: .91; }
  h2 { max-width: 23ch; margin: 0; font-size: clamp(1.55rem, 4vw, 2.25rem); line-height: 1; }

  .section { padding-block: var(--esp-2xl); border-bottom: 1px solid var(--bordure); scroll-margin-top: 3.5rem; }
  .section--fond { background: var(--surface-fond); }
  .manifeste { background: var(--surface-plate); }
  .manifeste__grille { display: grid; gap: var(--esp-xl); }
  /* Filet neutre : une couleur de classement posée ici ne classerait rien. */
  .prose { padding-left: var(--esp-l); border-left: 2px solid var(--bordure-forte); }
  .prose p { max-width: var(--largeur-lecture); margin: var(--esp-m) 0 0; color: var(--texte-secondaire); font-size: var(--txt-m); }
  .prose p:first-child { margin-top: 0; color: var(--texte-principal); font-size: var(--txt-l); }
  .section__entete { display: grid; gap: var(--esp-2xs); margin-bottom: var(--esp-l); }
  .section__entete > p { max-width: var(--largeur-intro); margin: 0; color: var(--texte-secondaire); font-size: var(--txt-m); text-wrap: pretty; }

  /* ---- La démarche ---- */
  .demarche__corps { display: grid; gap: var(--esp-l); }
  .etapes { display: grid; gap: var(--esp-s); margin: 0; padding: 0; list-style: none; }
  .etapes li { position: relative; display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--esp-m); padding: var(--esp-m); border: 1px solid var(--bordure); border-radius: var(--rayon); background: var(--surface-elevee); box-shadow: var(--ombre-courte); }
  .etapes li::before { position: absolute; inset: 0 auto 0 0; width: 2px; background: var(--couleur-action); content: ""; }
  .etapes > li > span { color: var(--texte-tertiaire); font-family: var(--font-mono); font-size: var(--txt-micro); }
  .etapes h3 { margin: 0 0 var(--esp-xs); font-size: var(--txt-xs); font-weight: var(--poids-fort); letter-spacing: var(--ls-label); text-transform: uppercase; }
  .etapes p { max-width: var(--largeur-lecture); margin: 0; color: var(--texte-secondaire); font-size: var(--txt-m); }
  .demarche__appui { display: grid; gap: var(--esp-m); align-content: start; }
  .demarche__note { max-width: var(--largeur-intro); margin: 0; color: var(--texte-secondaire); font-size: var(--txt-m); text-wrap: pretty; }

  /* ---- Applications ---- */
  /* Plafond de colonnes du référentiel (§Grilles) : la borne basse de minmax()
     vaut au moins 100 % / --cols, si bien que la grille ne peut pas dépasser
     --cols colonnes tout en se réduisant librement sur petit écran. */
  .applications { --gap-grille: var(--esp-s); display: grid; gap: var(--gap-grille); grid-template-columns: repeat(auto-fit, minmax(max(var(--min-col), (100% - (var(--cols) - 1) * var(--gap-grille)) / var(--cols)), 1fr)); }
  .applications--majeures { --cols: 2; --min-col: 19rem; margin-bottom: var(--esp-s); }
  .applications--courantes { --cols: 3; --min-col: 15rem; }

  /* ---- Sortie de page (dans l'aplat sombre du pied) ---- */
  .sortie { position: relative; z-index: 1; display: grid; gap: var(--esp-l); padding-block: var(--esp-2xl); color: var(--texte-sur-sombre); }
  .sortie .indice-section { color: var(--texte-sur-sombre-doux); }
  .sortie__phrase { max-width: 22ch; margin: 0; font-family: var(--font-display); font-size: clamp(2.25rem, 7vw, 4rem); font-weight: var(--poids-normal); line-height: .96; letter-spacing: var(--ls-titre); text-wrap: balance; }
  .sortie__suite { display: grid; gap: var(--esp-l); }
  .sortie__suite > p { max-width: var(--largeur-intro); margin: 0; color: var(--texte-sur-sombre-doux); font-size: var(--txt-m); }
  .sortie__appels { display: flex; flex-wrap: wrap; gap: var(--esp-xs); }
  .bouton {
    display: inline-flex;
    min-height: var(--cible);
    align-items: center;
    justify-content: center;
    padding-inline: var(--esp-m);
    border: 1px solid var(--focus-sur-sombre);
    border-radius: var(--rayon);
    background: var(--focus-sur-sombre);
    color: var(--vert-profond);
    font-size: var(--txt-xs);
    font-weight: var(--poids-fort);
    text-decoration: none;
  }
  .bouton--discret { background: transparent; color: var(--texte-sur-sombre); }
  .bouton--discret:hover { background: rgb(255 255 255 / 12%); }
  .sortie a:focus-visible { outline-color: var(--focus-sur-sombre); }

  @media (min-width: 42rem) {
    .hero { grid-template-columns: minmax(0, .82fr) minmax(22rem, 1.18fr); }
    .manifeste__grille { grid-template-columns: minmax(0, 1fr) minmax(18rem, .9fr); }
    .section__entete { grid-template-columns: 1fr minmax(18rem, .9fr); align-items: end; }
    .section__entete > p { justify-self: end; }
    .demarche__corps { grid-template-columns: minmax(0, 1.15fr) minmax(15rem, .85fr); gap: var(--esp-xl); }
    .sortie { grid-template-columns: minmax(0, 1fr) minmax(20rem, 1fr); align-items: start; }
    .sortie .indice-section { grid-column: 1 / -1; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
  }
</style>
