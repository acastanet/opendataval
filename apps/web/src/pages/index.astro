---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "@opendata-vda/shared/sections";

const applications = [
  {
    nom: "Feu",
    statut: "Déjà disponible",
    description: "Consignes officielles et niveau de danger dans les massifs gardois.",
    href: "/incendies/",
    classe: "feu",
    action: "Consulter le risque incendie",
  },
  {
    nom: "Eau",
    statut: "En cours de déploiement",
    description: "Suivre l'eau à Valleraugue : rivière, crues et nappe.",
    href: "/eau/",
    classe: "eau",
    action: "Découvrir l'application Eau",
  },
  {
    nom: "Terre",
    statut: "En cours de déploiement",
    description: "Explorer le territoire, ses paysages et ses données ouvertes.",
    href: "/carte/",
    classe: "terre",
    action: "Explorer la carte du territoire",
  },
];

// Index complet de toutes les pages du portail, regroupées par famille.
const groupes = [
  {
    titre: "Applications de terrain",
    liens: [
      { nom: "Feu — risque incendie", href: "/incendies/" },
      { nom: "Feu — temps réel & méthodologie", href: "/incendies/temps-reel/" },
      { nom: "Feu — vigilance incendie", href: "/vigilance-feu/" },
      { nom: "Eau — rivière, crues & nappe", href: "/eau/" },
      { nom: "Eau — tableau de bord", href: "/eau/tableau-de-bord/" },
      { nom: "Terre — carte du territoire", href: "/carte/" },
      { nom: "Relief 3D", href: "/relief/" },
      { nom: "Météo essentielle", href: "/meteo/essentiel/" },
      { nom: "Météo v2 (bêta)", href: "/meteo-v2/" },
    ],
  },
  {
    titre: "Thèmes & données",
    liens: SECTIONS.map((section) => ({ nom: section.titre, href: `/${section.slug}/` })),
  },
];
---

<Layout
  title="Val-d'Aigoual — Feu, Eau, Terre"
  description="Les applications de terrain de Val-d'Aigoual : Feu, Eau et Terre."
>
  <main>
    <section class="accueil" aria-labelledby="titre">
      <div class="conteneur">
        <p class="sur-titre">Val-d'Aigoual</p>
        <h1 id="titre">Feu, Eau, Terre</h1>
        <p class="introduction">Des applications simples pour comprendre le territoire et agir au bon moment.</p>

        <nav aria-label="Applications du territoire">
          <ul class="applications">
            {
              applications.map((application) => (
                <li>
                  <a class={`application ${application.classe}`} href={application.href} aria-label={application.action}>
                    <span class="repere" aria-hidden="true"></span>
                    <span class="statut">{application.statut}</span>
                    <strong>{application.nom}</strong>
                    <span class="description">{application.description}</span>
                    <span class="action">{application.action}<span aria-hidden="true"> →</span></span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </section>

    <section class="plan" aria-labelledby="titre-plan">
      <div class="conteneur">
        <p class="sur-titre">Plan du site</p>
        <h2 id="titre-plan">Toutes les pages du portail</h2>
        <div class="groupes">
          {
            groupes.map((groupe) => (
              <nav class="groupe" aria-label={groupe.titre}>
                <h3>{groupe.titre}</h3>
                <ul>
                  {groupe.liens.map((lien) => (
                    <li>
                      <a href={lien.href}>{lien.nom}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .accueil {
    display: grid;
    min-height: 100vh;
    align-items: center;
    padding: clamp(2rem, 8vw, 6rem) 0;
    background: linear-gradient(150deg, #f6f4ed 0%, #e7eee7 100%);
  }

  .conteneur {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .sur-titre {
    margin: 0;
    color: #37534b;
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.45rem 0 0;
    color: #17242c;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 10vw, 7.5rem);
    line-height: 0.88;
    letter-spacing: -0.045em;
  }

  .introduction {
    max-width: 48ch;
    margin: 1.25rem 0 0;
    color: #37534b;
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 600;
    line-height: 1.5;
  }

  .applications {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: clamp(2rem, 6vw, 4.25rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .application {
    --couleur: #3e805c;
    --fond: #e7f1e9;
    display: flex;
    min-height: 19rem;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 2px solid var(--couleur);
    border-radius: 10px;
    color: #17242c;
    background: var(--fond);
    box-shadow: 0 8px 20px rgba(23, 36, 44, 0.08);
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .application.feu { --couleur: #a93f08; --fond: #ffe0b2; }
  .application.eau { --couleur: #1463a4; --fond: #dceef9; }
  .application.terre { --couleur: #3e805c; --fond: #e2eedf; }

  .application:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 28px rgba(23, 36, 44, 0.16);
  }

  .application:focus-visible {
    outline: 4px solid #17242c;
    outline-offset: 4px;
  }

  .repere {
    display: block;
    width: 2.7rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--couleur);
  }

  .statut {
    margin-top: 1.5rem;
    color: #263841;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .application strong {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    line-height: 0.95;
  }

  .description {
    margin-top: 0.8rem;
    color: #263841;
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .action {
    display: flex;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 1.5rem;
    color: #17242c;
    font-size: 0.88rem;
    font-weight: 900;
    line-height: 1.35;
  }

  @media (max-width: 760px) {
    .applications { grid-template-columns: 1fr; }
    .application { min-height: 14rem; }
  }

  .plan {
    padding: clamp(2.5rem, 8vw, 5rem) 0;
    background: #17242c;
  }

  .plan .conteneur {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .plan .sur-titre {
    color: #9db7ac;
  }

  .plan h2 {
    margin: 0.45rem 0 0;
    color: #f6f4ed;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .groupes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: clamp(1.75rem, 5vw, 3rem);
  }

  .groupe h3 {
    margin: 0 0 0.9rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(246, 244, 237, 0.18);
    color: #f6f4ed;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .groupe ul {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .groupe a {
    display: block;
    padding: 0.5rem 0.6rem;
    margin: 0 -0.6rem;
    border-radius: 6px;
    color: #dfe7e2;
    font-size: 0.98rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 140ms ease, color 140ms ease;
  }

  .groupe a:hover {
    background: rgba(246, 244, 237, 0.08);
    color: #fff;
  }

  .groupe a:focus-visible {
    outline: 3px solid #9db7ac;
    outline-offset: 2px;
  }
</style>
