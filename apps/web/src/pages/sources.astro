---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SECTIONS, CATALOGUE_SOURCES } from "@opendata-vda/shared";

const groupes = SECTIONS.map((s) => ({
  section: s,
  sources: CATALOGUE_SOURCES.filter((src) => src.theme === s.slug),
})).filter((g) => g.sources.length > 0);
---
<Layout title="Sources & open data — Val-d'Aigoual" description="Catalogue des jeux de données, licences et fréquences de mise à jour du portail.">
  <SiteHeader sectionActive="sources" />

  <main class="page-sources">
    <header class="entete-section conteneur">
      <h1>Sources &amp; open data</h1>
      <p class="description-section">
        Catalogue complet des jeux de données ingérés par le portail, groupés par domaine.
        Les données sous <strong>Licence Ouverte / Etalab 2.0</strong> nécessitent une simple
        mention de la source ; celles sous <strong>ODbL</strong> (OpenStreetMap, Atmo Occitanie,
        liO) exigent en plus une attribution visible et le partage à l'identique.
      </p>
    </header>

    <div class="conteneur">
      {groupes.map((g) => (
        <section class="groupe-sources">
          <h2>
            <span class="pastille" style={`background:${g.section.couleur}`}></span>
            {g.section.titre}
          </h2>
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>Source</th>
                  <th>Licence</th>
                  <th>Fréquence</th>
                </tr>
              </thead>
              <tbody>
                {g.sources.map((s) => (
                  <tr>
                    <td><a href={s.url} target="_blank" rel="noopener">{s.nom}</a></td>
                    <td>{s.licence}</td>
                    <td>{s.frequence}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}
    </div>
  </main>

  <SiteFooter />
</Layout>

<style>
  .entete-section {
    margin-top: 2.4rem;
    margin-bottom: 2rem;
  }

  .entete-section h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .description-section {
    margin: 0.6rem 0 0;
    max-width: 64ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--border);
  }

  .groupe-sources {
    margin-bottom: 2.2rem;
    padding-bottom: 1.8rem;
    border-bottom: 1px solid var(--border);
  }

  .groupe-sources:last-child {
    border-bottom: none;
  }

  .groupe-sources h2 {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.9rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
  }

  .pastille {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .table-scroll {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 32rem;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  thead th {
    padding: 0.5rem 0.8rem;
    text-align: left;
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--border);
    border-bottom: 1.5px solid var(--fg);
  }

  tbody td {
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid var(--border);
  }

  tbody td:nth-child(2),
  tbody td:nth-child(3) {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--border);
  }
</style>
