---
import Layout from "../layouts/Layout.astro";
import BoutonAccueil from "../components/BoutonAccueil.astro";
import OldPerimetre from "../islands/OldPerimetre.svelte";
---

<Layout
  title="Périmètre OLD — Obligations légales de débroussaillement"
  description="Vérifier le zonage OLD et calculer un périmètre indicatif de débroussaillement depuis un bâtiment, le cadastre et le document d’urbanisme."
>
  <BoutonAccueil />
  <main class="page-old">
    <header>
      <p class="sur-titre">Prévention incendie · outil cartographique</p>
      <h1>Quel périmètre débroussailler&nbsp;?</h1>
      <p class="introduction">Sélectionnez une construction. L’outil vérifie le zonage OLD, recherche son emprise IGN et propose une surface de travail à confronter au cadastre, au PLU et au terrain.</p>
    </header>
    <OldPerimetre client:only="svelte" />
  </main>
</Layout>

<style>
  :global(body) { background: #f4f5f2; }
  .page-old { width: min(94rem, 100%); margin: 0 auto; padding: 1.2rem clamp(0.75rem, 3vw, 2rem) 3rem; }
  header { display: grid; grid-template-columns: minmax(15rem, 1fr) minmax(18rem, 35rem); align-items: end; gap: 1rem 3rem; padding: 1rem 0 1.4rem; border-top: 5px solid #17384b; }
  .sur-titre { grid-column: 1 / -1; margin: 0; color: #67737a; font-size: 0.72rem; font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase; }
  h1 { margin: 0; color: #17252d; font-family: var(--font-display); font-size: clamp(2.2rem, 5vw, 4.8rem); font-weight: 700; line-height: 0.95; letter-spacing: -0.035em; }
  .introduction { margin: 0; color: #4d5c63; font-size: clamp(0.95rem, 1.5vw, 1.12rem); line-height: 1.55; }
  @media (max-width: 760px) {
    header { grid-template-columns: 1fr; }
    .sur-titre { grid-column: auto; }
  }
</style>
