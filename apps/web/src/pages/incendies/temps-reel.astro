---
import Layout from "../../layouts/Layout.astro";
import FireExpertDashboard from "../../islands/FireExpertDashboard.svelte";
---

<Layout chrome="minimal" title="Temps réel incendies — Aigoual & Cévennes" description="Exploration des détections thermiques NASA FIRMS et périmètres de veille autour de l’Aigoual.">
  <main class="page-incendies">
    <header class="entete"><p class="sur-titre">Val-d’Aigoual · espace d’exploration</p><h1>Détections satellitaires récentes</h1><p class="introduction">Données NASA FIRMS en quasi-temps réel et périmètres de veille. Une détection peut être publiée plusieurs heures après le passage du satellite et ne confirme pas un incendie.</p></header>
    <nav class="onglets" aria-label="Sections de l’application incendies"><a href="../">Conseils officiels</a><a href="./" aria-current="page">Détections récentes</a></nav>
    <FireExpertDashboard client:only="svelte" />
    <noscript><p class="sans-script">L’exploration dynamique nécessite JavaScript. Pour un feu observé directement, appelez le 112 ou le 18. Les consignes officielles restent disponibles sur la <a href="https://www.risque-prevention-incendie.fr/gard/">carte du Gard</a>.</p></noscript>
  </main>
</Layout>

<style>
  .page-incendies { width:min(1120px,calc(100% - 2rem)); margin:0 auto; padding:clamp(1.5rem,6vw,4.5rem) 0 3rem; }.entete{ max-width:760px; padding-left:clamp(0rem,2vw,1rem); border-left:5px solid var(--surface-sombre); }.sur-titre{ margin:0 0 .6rem; color:var(--surface-sombre); font-size:.78rem; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }h1{ margin:0; color:var(--texte-principal); font-family:var(--font-display); font-size:clamp(2.35rem,7vw,5rem); line-height:.94; }.introduction{ max-width:65ch; margin:1rem 0 0; color:var(--texte-secondaire); font-size:1.06rem; font-weight:500; line-height:1.55; }.onglets{ display:inline-flex; gap:.4rem; max-width:100%; margin:2rem 0 1.25rem; padding:.35rem; border:1px solid var(--bordure-forte); border-radius:8px; background:var(--surface-fond); overflow-x:auto; }.onglets a{ display:grid; min-height:44px; place-items:center; padding:.65rem 1rem; border:1px solid transparent; border-radius:5px; color:var(--texte-principal); background:transparent; font-weight:800; white-space:nowrap; text-decoration:none; }.onglets a:hover{ border-color:var(--bordure-forte); background:var(--surface-plate); }.onglets a:focus-visible{ outline:3px solid #2472a4; outline-offset:2px; }.onglets a[aria-current="page"]{ color:#ffffff; border-color:var(--surface-sombre); background:var(--surface-sombre); box-shadow:0 1px 2px rgba(23,56,75,.28); }.sans-script{max-width:68ch;margin:1rem 0;padding:.75rem .85rem;border-left:5px solid #ad2434;border-radius:4px;color:var(--texte-principal);background:#fff0f2;font-size:.9rem;line-height:1.5}@media(max-width:700px){.page-incendies{width:min(100% - 1.25rem,1120px)}.sur-titre{font-size:.68rem;line-height:1.4}.introduction{font-size:1rem}.onglets{display:flex;width:100%;margin-top:1.5rem}.onglets a{flex:1;padding-inline:.7rem;font-size:.9rem}}
</style>
