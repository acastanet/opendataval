---
import Layout from "../../layouts/Layout.astro";
import MeteoPoint from "../../islands/MeteoPoint.svelte";
---

<Layout
  title="Météo essentielle — Val-d’Aigoual"
  description="Météo locale essentielle : position GPS, situation actuelle, risque à venir et prévisions utiles."
>
  <main class="page-meteo-shell theme-meteo-sombre">
    <MeteoPoint client:only="svelte" mode="essentiel" />
  </main>
</Layout>

<style>
  :global(body) {
    background: var(--meteo-background);
  }

  :global(#racine) {
    min-height: 100%;
  }

</style>
