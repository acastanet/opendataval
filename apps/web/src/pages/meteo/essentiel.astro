---
import Layout from "../../layouts/Layout.astro";
import MeteoEssentiel from "../../islands/MeteoEssentiel.svelte";
---

<Layout chrome="minimal"
  title="Météo essentielle — Val-d’Aigoual"
  description="Météo locale essentielle : position GPS, situation actuelle, risque à venir et prévisions utiles."
>
  <main class="page-meteo-essentiel">
    <MeteoEssentiel client:only="svelte" />
  </main>
</Layout>

<style>
  :global(body) {
    background: var(--surface-plate);
  }

  :global(#racine) {
    min-height: 100%;
  }

  .page-meteo-essentiel {
    min-height: 100%;
    background: var(--surface-plate);
  }

</style>
