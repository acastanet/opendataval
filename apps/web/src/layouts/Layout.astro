---
import "../../../../packages/shared/styles/design-system.css";
import "../styles/map-controls.css";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BoutonAccueil from "../components/BoutonAccueil.astro";

interface Props {
  title: string;
  description?: string;
  /**
   * Niveau d'habillage du site.
   * - `complet` : barre permanente et pied de page — pages éditoriales.
   * - `minimal` : languette de retour à l'accueil seule — applications plein
   *   écran, où une barre de 3,5 rem prendrait la place de la carte.
   * - `aucun`   : vues embarquées.
   */
  chrome?: "complet" | "minimal" | "aucun";
}
const {
  title,
  description = "Portail open data de Val-d'Aigoual et de la Communauté de communes Causses Aigoual Cévennes – Terres Solidaires.",
  chrome = "complet",
} = Astro.props;
const pathname = Astro.url.pathname;
const varianteEntete = pathname === "/" || pathname === "" ? "accueil" : "page";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef3ef" />
    <link rel="preload" href="/fonts/SourceSerif4-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/Inter-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    {/* Les polices sont auto-hébergées dans le socle de styles partagé :
        fonts.gstatic.com transmettrait l'adresse IP des visiteurs à un tiers,
        ce qui n'est pas tenable pour un service public territorial. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
  </head>
  <body>
    <div id="racine">
      {chrome === "complet" && (
        <SiteHeader variante={varianteEntete} pathname={pathname} />
      )}
      {chrome === "minimal" && <BoutonAccueil />}

      {chrome === "complet" ? (
        <div id="contenu"><slot /></div>
      ) : (
        <slot />
      )}

      {chrome === "complet" && (
        <SiteFooter>
          <slot name="final" slot="final" />
        </SiteFooter>
      )}
    </div>
  </body>
</html>
