<figure class="hero-visual" data-hero-visual>
  <div class="hero-visual__placeholder" aria-label="Animation cartographique Three.js temporaire">
    <canvas data-hero-scene aria-hidden="true"></canvas>
    <span>Animation Three.js · temporaire</span>
  </div>
  <figcaption>
    <strong>Le lieu comme point de départ</strong>
    <span>Une esquisse animée des relations entre un point et son territoire.</span>
  </figcaption>
</figure>

<script>
  import * as THREE from "three";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-hero-visual]").forEach((visual) => {
    const canvas = visual.querySelector<HTMLCanvasElement>("[data-hero-scene]");
    if (!canvas || !canvas.parentElement) return;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));
    renderer.setClearColor(0x000000, 0);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(36, 1, 0.1, 100);
    camera.position.set(0, 1.1, 8.8);

    const group = new THREE.Group();
    group.rotation.x = -0.12;
    scene.add(group);

    const gridGeometry = new THREE.PlaneGeometry(7.4, 5.2, 18, 14);
    const positions = gridGeometry.attributes.position;
    for (let index = 0; index < positions.count; index += 1) {
      const x = positions.getX(index);
      const y = positions.getY(index);
      const relief = Math.sin(x * 1.25) * 0.14 + Math.cos(y * 1.7) * 0.1;
      positions.setZ(index, relief);
    }
    gridGeometry.computeVertexNormals();

    const terrain = new THREE.Mesh(
      gridGeometry,
      new THREE.MeshBasicMaterial({ color: 0x426d62, wireframe: true, transparent: true, opacity: 0.2 }),
    );
    terrain.rotation.x = -0.72;
    terrain.position.y = -0.25;
    group.add(terrain);

    const ringMaterial = new THREE.LineBasicMaterial({ color: 0x1d5c4b, transparent: true, opacity: 0.55 });
    [0.55, 1.15, 1.9].forEach((radius, index) => {
      const points = Array.from({ length: 80 }, (_, pointIndex) => {
        const angle = (pointIndex / 80) * Math.PI * 2;
        return new THREE.Vector3(Math.cos(angle) * radius, Math.sin(angle) * radius * 0.52, 0.8 - index * 0.08);
      });
      const ring = new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(points), ringMaterial);
      ring.rotation.z = index * 0.18;
      group.add(ring);
    });

    const marker = new THREE.Mesh(
      new THREE.SphereGeometry(0.12, 24, 24),
      new THREE.MeshBasicMaterial({ color: 0xd8703f }),
    );
    marker.position.z = 1;
    group.add(marker);

    const halo = new THREE.Mesh(
      new THREE.RingGeometry(0.2, 0.24, 48),
      new THREE.MeshBasicMaterial({ color: 0xd8703f, transparent: true, opacity: 0.7, side: THREE.DoubleSide }),
    );
    halo.position.z = 0.98;
    group.add(halo);

    const resize = () => {
      const { width, height } = canvas.parentElement!.getBoundingClientRect();
      renderer.setSize(width, height, false);
      camera.aspect = width / Math.max(height, 1);
      camera.updateProjectionMatrix();
    };

    const observer = new ResizeObserver(resize);
    observer.observe(canvas.parentElement);
    resize();

    let frame = 0;
    const render = (time = 0) => {
      const progress = time * 0.00018;
      group.rotation.z = Math.sin(progress) * 0.045;
      marker.scale.setScalar(1 + Math.sin(time * 0.0022) * 0.12);
      halo.scale.setScalar(1 + Math.sin(time * 0.0015) * 0.22);
      renderer.render(scene, camera);
      if (!reduceMotion) frame = requestAnimationFrame(render);
    };
    render();

    document.addEventListener("astro:before-swap", () => {
      cancelAnimationFrame(frame);
      observer.disconnect();
      renderer.dispose();
      gridGeometry.dispose();
    }, { once: true });
  });
</script>

<style>
  .hero-visual { position: relative; min-width: 0; margin: 0; }
  .hero-visual__placeholder { position: relative; min-height: clamp(18rem, 38vw, 30rem); overflow: hidden; border: 1px solid var(--bordure-forte); border-radius: var(--rayon); background: linear-gradient(145deg, rgb(218 231 225 / 70%), rgb(238 243 239 / 22%)); box-shadow: var(--ombre); }
  .hero-visual__placeholder::before { position: absolute; inset: var(--esp-m); border: 1px dashed rgb(36 84 61 / 25%); border-radius: calc(var(--rayon) / 2); content: ""; pointer-events: none; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-visual__placeholder > span { position: absolute; right: var(--esp-m); bottom: var(--esp-m); padding: var(--esp-3xs) var(--esp-2xs); border: 1px solid rgb(36 84 61 / 25%); border-radius: 999px; background: rgb(251 252 250 / 78%); color: var(--texte-secondaire); font-family: var(--font-mono); font-size: var(--txt-micro); letter-spacing: var(--ls-label); text-transform: uppercase; backdrop-filter: blur(8px); }
  figcaption { display: grid; gap: var(--esp-3xs); padding: var(--esp-s) var(--esp-2xs) 0; }
  figcaption strong { font-family: var(--font-display); font-size: var(--txt-l); font-weight: var(--poids-normal); }
  figcaption span { max-width: 42ch; color: var(--texte-secondaire); font-size: var(--txt-xs); }

  @media (max-width: 41.99rem) {
    .hero-visual__placeholder { min-height: 15rem; }
  }
</style>
