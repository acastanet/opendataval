---
// Chevron « retour accueil » partagé, identique sur tout le portail.
// - variante "flottant" : position fixe en haut à gauche, pour les pages immersives.
// - variante "inline"   : en flux normal, pour être placé dans le bandeau SiteHeader.
interface Props {
  variante?: "flottant" | "inline";
}
const { variante = "flottant" } = Astro.props;
---
<a class:list={["bouton-accueil", variante]} href="/" aria-label="Retour à l'accueil">
  <svg viewBox="0 0 20 20" aria-hidden="true">
    <path d="M12.5 4 7 10l5.5 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>

<style>
  .bouton-accueil {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    transition: background 150ms ease;
  }

  .bouton-accueil svg {
    width: 1rem;
    height: 1rem;
  }

  .bouton-accueil:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  /* Variante flottante : lisible sur fond clair comme sur carte sombre. */
  .bouton-accueil.flottant {
    position: fixed;
    top: 0.7rem;
    left: 0.7rem;
    z-index: 1000;
    color: #fff;
    background: rgba(20, 24, 27, 0.55);
    backdrop-filter: blur(3px);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
  }

  .bouton-accueil.flottant:hover {
    background: rgba(20, 24, 27, 0.72);
  }

  .bouton-accueil.flottant:focus-visible {
    outline-color: #fff;
  }

  /* Variante intégrée au bandeau : s'accorde au header clair. */
  .bouton-accueil.inline {
    align-self: center;
    color: var(--fg);
    background: rgba(154, 155, 147, 0.18);
  }

  .bouton-accueil.inline:hover {
    background: rgba(154, 155, 147, 0.32);
  }
</style>
