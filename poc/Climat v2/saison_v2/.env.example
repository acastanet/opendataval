# Jeton personnel du Copernicus Climate Data Store (ne jamais le committer).
COPERNICUS_CDS_KEY=personal-access-token
COPERNICUS_CDS_URL=https://cds.climate.copernicus.eu/api

# En production, remplacer * par le domaine qui consomme l'API.
CORS_ORIGINS=*

# Une seule collecte/calcul simultané protège les ressources et le quota CDS.
SEASONS_MAX_CONCURRENT=1
