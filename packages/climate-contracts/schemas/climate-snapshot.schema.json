{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClimateSnapshot",
  "description": "Manifest immuable des actifs climatiques acquis pour une fiche.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "created_at",
    "requested_location",
    "assets",
    "quality"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "requested_location": {"$ref": "#/$defs/requestedLocation"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "dataset_registry_id", "dataset_id", "provider", "variables", "period", "retrieval", "storage", "quality"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "dataset_registry_id": {"type": "string", "minLength": 1},
          "dataset_id": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "variables": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "period": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {
              "start": {"type": "string"},
              "end": {"type": "string"}
            }
          },
          "requested_spatial": {"type": "object", "additionalProperties": true},
          "represented_spatial": {"type": "object", "additionalProperties": true},
          "retrieval": {
            "type": "object",
            "additionalProperties": true,
            "required": ["retrieved_at"],
            "properties": {
              "retrieved_at": {"type": "string", "format": "date-time"},
              "dataset_version": {"type": ["string", "null"]},
              "request_parameters": {"type": "object", "additionalProperties": true}
            }
          },
          "storage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uri", "sha256"],
            "properties": {
              "uri": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
              "media_type": {"type": "string"}
            }
          },
          "quality": {
            "type": "object",
            "additionalProperties": true,
            "required": ["status"],
            "properties": {
              "status": {"enum": ["valid", "partial", "failed"]}
            }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["valid", "partial", "failed"]}
      }
    },
    "provenance": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "geometry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"enum": ["Point", "Polygon", "MultiPolygon"]},
        "coordinates": {}
      }
    },
    "requestedLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry"],
      "properties": {
        "geometry": {"$ref": "#/$defs/geometry"},
        "label": {"type": "string"},
        "tile_id": {"type": "string"}
      }
    }
  }
}
