{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClimateSignal",
  "description": "Fait interprétable déterministe produit par une méthode climatique OpenDataVal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "definition_id",
    "method",
    "metric",
    "claim_level",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "definition_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "method": {
      "$ref": "#/$defs/methodRef"
    },
    "metric": {
      "type": "string",
      "minLength": 1
    },
    "claim_level": {
      "enum": [
        "descriptive",
        "statistical_trend",
        "causal_attribution"
      ]
    },
    "value": {},
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "direction": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "higher",
        "lower",
        "stable",
        "earlier",
        "later",
        "longer",
        "shorter",
        "more_frequent",
        "less_frequent",
        "very_low",
        "very_high",
        "low",
        "normal",
        "high"
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "early_period": {
          "type": [
            "string",
            "null"
          ]
        },
        "late_period": {
          "type": [
            "string",
            "null"
          ]
        },
        "early_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "late_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "delta": {
          "type": [
            "number",
            "null"
          ]
        },
        "relative_pct": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result_pointer"
        ],
        "properties": {
          "result_pointer": {
            "type": "string",
            "pattern": "^/"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "caveat_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "quality_status": {
      "enum": [
        "valid",
        "partial",
        "insufficient"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "methodRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    }
  }
}
