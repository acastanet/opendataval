{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClimateCommentary",
  "description": "Commentaire IA contrôlé; chaque constat doit référencer au moins un ClimateSignal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "commentary_id",
    "scope",
    "result_ids",
    "summary",
    "findings",
    "caveats",
    "generation",
    "validation"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "commentary_id": {"type": "string", "minLength": 1},
    "scope": {"enum": ["infographic", "sheet"]},
    "result_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "method_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/methodRef"}
    },
    "summary": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "signal_ids", "claim_level"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "signal_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "claim_level": {"enum": ["descriptive", "statistical_trend", "causal_attribution"]}
        }
      }
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "signal_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "abstentions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason"],
        "properties": {
          "reason": {"type": "string", "minLength": 1},
          "signal_definition_id": {"type": ["string", "null"]}
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at", "service", "model", "prompt_version"],
      "properties": {
        "generated_at": {"type": "string", "format": "date-time"},
        "service": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "prompt_version": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "all_findings_have_signal_evidence"],
      "properties": {
        "status": {"enum": ["valid", "rejected", "needs_review"]},
        "all_findings_have_signal_evidence": {"type": "boolean"},
        "unsupported_claims": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "methodRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    }
  }
}
