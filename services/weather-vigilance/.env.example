PORT=3000
METEOFRANCE_VIGILANCE_API_URL=https://public-api.meteofrance.fr/public/DPVigilance/v1
METEOFRANCE_VIGILANCE_API_TOKEN=
METEOFRANCE_VIGILANCE_AUTH_MODE=apikey
VIGILANCE_REFRESH_SECONDS=300
VIGILANCE_STALE_AFTER_SECONDS=900
VIGILANCE_EXPIRE_AFTER_SECONDS=21600
VIGILANCE_CONNECT_TIMEOUT_MS=3000
VIGILANCE_READ_TIMEOUT_MS=10000
VIGILANCE_MAX_RETRIES=2
VIGILANCE_MAX_RESPONSE_BYTES=5000000
VIGILANCE_CIRCUIT_FAILURE_THRESHOLD=3
VIGILANCE_CIRCUIT_OPEN_SECONDS=60
VIGILANCE_SNAPSHOT_PATH=/app/data/vigilance-snapshot.json
APP_VERSION=dev
GIT_SHA=
BUILT_AT=
