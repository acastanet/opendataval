POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=opendata
# Générez une valeur forte, par exemple avec : openssl rand -base64 32
POSTGRES_PASSWORD=REMPLACER_PAR_UN_SECRET_FORT
POSTGRES_DB=opendata_vda

# Brique 4 : tokens OAuth du portail-api.meteofrance.fr.
# Un token est lié à une souscription : utiliser un token distinct pour chaque jeu
# de données, créé dans une application dédiée sur le portail.
#  - METEOFRANCE_API_TOKEN : DPObs v2 local (jobs "meteo_obs" / "meteo_radome") ;
#  - METEOFRANCE_STATIONS_API_TOKEN : catalogue national (job "meteo_stations") ;
#    https://public-api.meteofrance.fr/public/DPObs/v2/liste-stations
#  - METEOFRANCE_OBS_NATIONAL_API_TOKEN : paquet horaire national (job "meteo_obs_national") ;
#    https://public-api.meteofrance.fr/public/DPPaquetObs/v2/paquet/stations/horaire
#  - METEOFRANCE_API_TOKEN_VIGILANCE : ancien nom du token DPVigilance, conservé pour compatibilité.
#  - METEOFRANCE_VIGILANCE_API_TOKEN : token dédié au microservice du lot 4.
# Sans ces tokens, les jobs worker et/ou les services concernés se dégradent proprement.
METEOFRANCE_API_TOKEN=
METEOFRANCE_STATIONS_API_TOKEN=
METEOFRANCE_OBS_NATIONAL_API_TOKEN=
METEOFRANCE_API_TOKEN_VIGILANCE=
METEOFRANCE_VIGILANCE_API_TOKEN=
METEOFRANCE_VIGILANCE_API_URL=https://public-api.meteofrance.fr/public/DPVigilance/v1
# apikey conserve la compatibilité du déploiement actuel ; bearer active Authorization: Bearer.
METEOFRANCE_VIGILANCE_AUTH_MODE=apikey
VIGILANCE_REFRESH_SECONDS=300
VIGILANCE_STALE_AFTER_SECONDS=900
VIGILANCE_EXPIRE_AFTER_SECONDS=21600
VIGILANCE_CONNECT_TIMEOUT_MS=3000
VIGILANCE_READ_TIMEOUT_MS=10000
VIGILANCE_MAX_RETRIES=2
VIGILANCE_MAX_RESPONSE_BYTES=5000000
VIGILANCE_CIRCUIT_FAILURE_THRESHOLD=3
VIGILANCE_CIRCUIT_OPEN_SECONDS=60
VIGILANCE_SERVICE_TIMEOUT_MS=3000

# Clé API gratuite (compte sur infoclimat.fr, usage non commercial) pour le réseau de stations
# amateurs StatIC. Sans cette clé, le job worker "meteo_infoclimat" est automatiquement désactivé.
INFOCLIMAT_API_TOKEN=

# Clé serveur NASA FIRMS. Elle ne doit jamais être exposée au navigateur ni commitée.
NASA_FIRMS_MAP_KEY=

# Compte gratuit EUMETSAT Data Store. Les deux valeurs sont des secrets serveur.
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=
EUMETSAT_TOKEN_URL=https://api.eumetsat.int/token
EUMETSAT_SEARCH_URL=https://api.eumetsat.int/data/search-products/1.0.0/os
EUMETSAT_BROWSE_URL=https://api.eumetsat.int/data/browse
EUMETSAT_DOWNLOAD_URL=https://api.eumetsat.int/data/download/1.0.0
EUMETSAT_MTG_FIRE_COLLECTION=EO:EUM:DAT:0801
EUMETSAT_MSG_FIRE_COLLECTION=EO:EUM:DAT:MSG:FIRC
EUMETSAT_TIMEOUT_MS=10000
EUMETSAT_MAX_PRODUCTS=24
FIRMS_API_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv
FIRMS_TIMEOUT_MS=8000
FIRMS_MAX_RETRIES=1
FIRE_DEFAULT_RADIUS_KM=50
FIRE_MAX_RADIUS_KM=100
FIRE_HISTORY_DAYS=7
FIRE_REALTIME_WINDOW_MINUTES=90
FIRE_CACHE_SECONDS=45
FIRE_MAX_RESPONSE_BYTES=5000000
FIRE_DETECTION_SERVICE_TIMEOUT_MS=20000

# Copernicus Climate Data Store : secret serveur, jamais exposé au navigateur.
# Les conditions d'utilisation du jeu de données doivent être acceptées sur le CDS avant usage.
COPERNICUS_CDS_URL=https://cds.climate.copernicus.eu/api
COPERNICUS_CDS_KEY=
# false : service dédié planifié ; true : une seule exécution puis arrêt.
COPERNICUS_RUN_ONCE=false
# Le mois cible peut être forcé lors d'un RUN_ONCE avec COPERNICUS_TARGET_MONTH=AAAA-MM.
COPERNICUS_PRODUCT_TYPE=intermediate_dataset

# Fichiers de secours Gard validés manuellement : data/incendies/YYYYMMDD.json

# Brique 3 (non requis pour le MVP) :
# DATATOURISME_API_KEY=

SITE_DOMAIN=localhost
