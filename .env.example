POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=opendata
# Générez une valeur forte, par exemple avec : openssl rand -base64 32
POSTGRES_PASSWORD=REMPLACER_PAR_UN_SECRET_FORT
POSTGRES_DB=opendata_vda

# Brique 4 : tokens OAuth du portail-api.meteofrance.fr.
# Chaque souscription nécessite un token dédié (applications séparées sur le portail) :
#  - METEOFRANCE_API_TOKEN       -> DPObs (worker "meteo_obs" / "meteo_radome") ;
#  - METEOFRANCE_API_TOKEN_VIGILANCE -> DonneesPubliquesVigilance (route API /api/meteo/point, encart Vigilance du Gard).
# Sans ces tokens, les jobs worker et/ou l'encart Vigilance se dégradent proprement.
METEOFRANCE_API_TOKEN=
METEOFRANCE_API_TOKEN_VIGILANCE=

# Clé API gratuite (compte sur infoclimat.fr, usage non commercial) pour le réseau de stations
# amateurs StatIC. Sans cette clé, le job worker "meteo_infoclimat" est automatiquement désactivé.
INFOCLIMAT_API_TOKEN=

# Clé serveur NASA FIRMS. Elle ne doit jamais être exposée au navigateur ni commitée.
NASA_FIRMS_MAP_KEY=

# Fichiers de secours Gard validés manuellement : data/incendies/YYYYMMDD.json

# Brique 3 (non requis pour le MVP) :
# DATATOURISME_API_KEY=

SITE_DOMAIN=localhost
