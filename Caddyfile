{
	auto_https off
}

http://{$SITE_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'self'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://data.geopf.fr; connect-src 'self' https://data.geopf.fr; worker-src 'self' blob:; child-src 'self' blob:; font-src 'self' data:;"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# HSTS uniquement hors localhost/127.0.0.1 : en local, la stack est servie en HTTP simple
	# et cet en-tête ferait basculer le navigateur en HTTPS (port 443, non ecoute) — ce qui
	# provoque ERR_CONNECTION_REFUSED sur https://localhost/. En production (SITE_DOMAIN reel
	# derriere TLS), l'en-tete reste emis.
	@securise not host localhost 127.0.0.1
	header @securise Strict-Transport-Security "max-age=31536000; includeSubDomains"

	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Les nouvelles API passent par le gateway. Les routes /api/* historiques restent
	# directement servies par le monolithe pendant la migration progressive.
	@gateway path /api/v2 /api/v2/*
	handle @gateway {
		reverse_proxy gateway:3000
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		file_server
	}
}
