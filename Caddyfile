{
	auto_https off
}

http://:80 {
	# En-têtes de securite pour les fichiers statiques
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'self'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://data.geopf.fr; connect-src 'self' https://data.geopf.fr; worker-src 'self' blob:; child-src 'self' blob:; font-src 'self' data:;"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# HSTS en production uniquement
	@securise not host localhost 127.0.0.1
	header @securise Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Cache immutable pour les assets Astro
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# API — pas de compression (fastify gere le content-length)
	handle /api/* {
		reverse_proxy api:3000
	}

	# Fichiers statiques avec compression
	handle {
		encode zstd gzip
		root * /srv
		file_server
	}
}
