FROM node:22-alpine AS webbuild
WORKDIR /app
ENV npm_config_fetch_retries=5 \
    npm_config_fetch_retry_mintimeout=10000 \
    npm_config_fetch_retry_maxtimeout=120000 \
    npm_config_fetch_timeout=300000 \
    npm_config_store_dir=/pnpm/store
RUN npm install -g pnpm@11.10.0

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/meteo-web/package.json apps/meteo-web/package.json
RUN --mount=type=cache,id=opendataval-pnpm-v11,target=/pnpm/store,sharing=locked \
    pnpm install --filter web... --filter meteo-web... --frozen-lockfile --prefer-offline

COPY packages/shared packages/shared
COPY apps/web apps/web
COPY apps/meteo-web apps/meteo-web
COPY doc/architecture/conception-v2 doc/architecture/conception-v2
RUN pnpm --filter web build \
 && pnpm --filter meteo-web run generate:api \
 && pnpm --filter meteo-web build

FROM caddy:2-alpine
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=webbuild /app/apps/web/dist /srv
COPY --from=webbuild /app/apps/meteo-web/dist /srv/meteo-v2
# Les extraits de relief (/srv/relief/*.pmtiles, ~2 Go) ne sont pas buildés ici : ils sont
# exclus du contexte (.dockerignore) et montés au runtime depuis l'hôte (docker-compose.yml).
